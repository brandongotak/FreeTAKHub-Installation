System:
  FTS_DATABASE_TYPE: {{ fts_database_type }}
  FTS_CONNECTION_MESSAGE: {{ fts_connection_message }}
  FTS_OPTIMIZE_API: {{ fts_optimize_api | title }}
  FTS_MAINLOOP_DELAY: {{ fts_mainloop_delay | int }}
Addresses:
  FTS_COT_PORT: {{ fts_cot_port | int }}
  FTS_SSLCOT_PORT: {{ fts_sslcot_port | int }}
  FTS_DP_ADDRESS: {{ fts_public_ipv4 }}
  FTS_USER_ADDRESS: {{ fts_public_ipv4 }}
  FTS_API_PORT: {{ fts_api_port | int }}
  FTS_FED_PORT: {{ fts_fed_port | int }}
  FTS_API_ADDRESS: {{ fts_public_ipv4 }}
# FTS reads this section as "Filesystem". Certs, ExCheck, data packages and
# logs use FTS's defaults under the persistence path ({{ fts_data_path }}) so
# they survive reinstalls instead of living inside the venv.
Filesystem:
  FTS_DB_PATH: {{ fts_db_path }}
  FTS_COT_TO_DB: {{ fts_cot_to_db | title }}
Certs:
  FTS_FEDERATION_KEYPASS: {{ fts_federation_keypass }}
  FTS_CLIENT_CERT_PASSWORD: {{ fts_client_cert_password }}
  FTS_WEBSOCKET_KEY: {{ fts_websocket_key }}
