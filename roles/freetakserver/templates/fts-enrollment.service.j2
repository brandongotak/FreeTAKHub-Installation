[Unit]
Description=FreeTAKServer certificate enrollment service
After=network.target
# written by FreeTAKServer.core.util.enrollment_setup (installer --domain or
# the UI configure page) with the domain, port and Let's Encrypt cert paths
ConditionPathExists={{ fts_enrollment_env_file }}

[Service]
Type=simple
Restart=always
RestartSec=5
StandardOutput=append:/var/log/{{ fts_enrollment_service_name }}/{{ fts_enrollment_service_name }}-stdout.log
StandardError=append:/var/log/{{ fts_enrollment_service_name }}/{{ fts_enrollment_service_name }}-stderr.log
WorkingDirectory={{ fts_data_path }}
Environment="FTS_PERSISTENCE_PATH={{ fts_data_path }}"
Environment="FTS_CONFIG_PATH={{ fts_config_path }}"
EnvironmentFile={{ fts_enrollment_env_file }}
ExecStart={{ fts_venv }}/bin/python3 -m FreeTAKServer.services.enrollment_service

[Install]
WantedBy=multi-user.target
